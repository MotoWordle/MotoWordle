Test mode feedback

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MotoWordle – Test Mode</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      text-align: center;
      background: #0f0f0f;
      color: #eee;
      margin: 0;
      padding: 20px;
      line-height: 1.4;
    }
    h1 { margin-bottom: 0.2em; }
    
    #test-controls {
      background: #1a1a1a;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 20px;
      border: 1px solid #333;
    }
    
    #image-container {
      width: 100%;
      max-width: 800px;
      height: 420px;
      margin: 20px auto;
      overflow: hidden;
      border: 4px solid #333;
      border-radius: 12px;
      background: #111;
    }
    
    #image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    
    .controls { margin: 15px 0; }
    
    .field-group {
      display: inline-block;
      margin: 0 12px;
      vertical-align: top;
    }
    
    select, input, button {
      padding: 10px 12px;
      margin: 5px;
      font-size: 16px;
      border-radius: 6px;
      border: 1px solid #444;
      background: #222;
      color: #eee;
    }
    
    button {
      background: #1a6b3a;
      border: none;
      cursor: pointer;
      font-weight: 600;
    }
    button:hover { background: #218c4e; }
    button:disabled { background: #444; cursor: not-allowed; }
    
    .feedback-icon {
      display: block;
      font-size: 22px;
      font-weight: bold;
      height: 28px;
      margin-top: 4px;
    }
    
    .correct { color: #4ade80; }
    .wrong { color: #f87171; }
    
    #guessHistory {
      margin: 25px auto;
      max-width: 520px;
      text-align: left;
      background: #1a1a1a;
      padding: 15px 20px;
      border-radius: 10px;
      border: 1px solid #333;
    }
    
    #guessHistory h3 {
      margin-top: 0;
      text-align: center;
    }
    
    .guess-item {
      padding: 6px 0;
      border-bottom: 1px solid #333;
      font-size: 15px;
    }
    
    .guess-item:last-child {
      border-bottom: none;
    }
    
    .info { margin: 10px 0; font-size: 1.1em; }
    #scoreDisplay { font-size: 1.3em; color: #ffd700; margin: 12px 0; }
    #message { min-height: 1.5em; margin: 10px 0; font-weight: 500; }
    .success { color: #4ade80; }
    .fail { color: #f87171; }
    #shareBtn { background: #2563eb; display: none; }
    #attribution {
      font-size: 0.85em;
      color: #888;
      margin-top: 8px;
    }
  </style>
</head>
<body>
  <h1>🏍️ MotoWordle</h1>
  
  <div id="test-controls">
    <strong>Test Mode:</strong>
    <select id="testBikeSelect">
      <option value="">-- Select a bike to test --</option>
    </select>
    <button onclick="loadTestBike()">Load Selected Bike</button>
  </div>
  
  <div class="info">🔥 Streak: <span id="streak">0</span></div>
  
  <div id="image-container">
    <img id="image" src="" alt="Motorcycle">
  </div>
  <div id="attribution"></div>
  
  <div class="controls">
    <div class="field-group">
      <select id="make">
        <option value="">Select Make</option>
      </select>
      <span id="makeFeedback" class="feedback-icon"></span>
    </div>

    <div class="field-group">
      <select id="model" disabled>
        <option value="">Select Model</option>
      </select>
      <span id="modelFeedback" class="feedback-icon"></span>
    </div>

    <div class="field-group">
      <input id="year" type="number" placeholder="Year" min="1900" max="2030">
      <span id="yearFeedback" class="feedback-icon"></span>
    </div>
    
    <br><br>
    <button id="submitBtn" onclick="submitGuess()">Submit Guess</button>
    <button onclick="revealAnswer()">Give Up</button>
    <button id="shareBtn" onclick="shareResults()">Share Results</button>
  </div>
  
  <div id="scoreDisplay">Score: 0 / 100</div>
  <div class="info">Tries left: <span id="tries">5</span></div>
  <div id="message"></div>

  <div id="guessHistory">
    <h3>Guess History</h3>
    <div id="historyList">
      <div class="guess-item">No guesses yet</div>
    </div>
  </div>

  <script>
    const bikes = [
      // BMW
      { id: 1, year: 1923, make: "BMW", model: "R32", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/BMW/1923%20BMW%20R32.jpg", attribution: "" },
      { id: 2, year: 2002, make: "BMW", model: "R1150GS", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/BMW/2002%20BMW%20R1150GS.jpg", attribution: "" },
      { id: 3, year: 2009, make: "BMW", model: "S1000RR", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/BMW/2009%20BMW%20S1000RR.jpg", attribution: "" },
      { id: 4, year: 2001, make: "BMW", model: "C1", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/BMW/2001%20BMW%20C1.jpg", attribution: "" },
      { id: 5, year: 1975, make: "BMW", model: "R75/6", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/BMW/1975%20BMW%20R75_6.JPG", attribution: "" },
      { id: 6, year: 2021, make: "BMW", model: "F850GS", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/BMW/2021%20BMW%20F850GS.jpg", attribution: "" },
      { id: 7, year: 2022, make: "BMW", model: "R nineT", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/BMW/2022%20BMW%20R%20NineT.jpg", attribution: "" },

      // Harley-Davidson
      { id: 8, year: 1926, make: "Harley-Davidson", model: "Model B", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Harley-Davidson/1926%20Harley-Davidson%20Model%20B.jpg", attribution: "" },
      { id: 9, year: 1944, make: "Harley-Davidson", model: "Model U", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Harley-Davidson/1944%20Harley-Davidson%20Model%20U.jpg", attribution: "" },
      { id: 10, year: 1973, make: "Harley-Davidson", model: "Electra Glide", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Harley-Davidson/1973%20Harley-Davidson%20Electra%20Glide.jpg", attribution: "Vauxford" },
      { id: 11, year: 2022, make: "Harley-Davidson", model: "Pan America", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Harley-Davidson/2022%20Harley-Davidson%20Pan%20America.jpg", attribution: "Frank Schwichtenberg" },
      { id: 12, year: 2005, make: "Harley-Davidson", model: "Fat Boy", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Harley-Davidson/2005%20Harley-Davidson%20Fat%20Boy.jpg", attribution: "Bob Adams" },
      { id: 13, year: 2002, make: "Harley-Davidson", model: "V-Rod", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Harley-Davidson/2002%20Harley-Davidson%20V-Rod.jpg", attribution: "" },
      { id: 14, year: 2023, make: "Harley-Davidson", model: "Road Glide Special", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Harley-Davidson/2023%20Harley-Davidson%20Road%20Glide%20Special.jpg", attribution: "" },

      // Honda
      { id: 15, year: 1958, make: "Honda", model: "Super Cub", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/1958%20Honda%20Super%20Cub.jpg", attribution: "Mj-bird" },
      { id: 16, year: 1969, make: "Honda", model: "CB750", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/1969%20Honda%20CB750.JPG", attribution: "Slarty-bart-farst" },
      { id: 17, year: 1974, make: "Honda", model: "Gold Wing", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/1974%20Honda%20Gold%20Wing.jpg", attribution: "Ronald Saunders" },
      { id: 18, year: 1988, make: "Honda", model: "RC30", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/1988%20Honda%20VFR750R%20RC30.JPG", attribution: "Rainmaker47" },
      { id: 19, year: 1995, make: "Honda", model: "RC45", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/1995%20Honda%20RVF750R%20RC45.jpg", attribution: "Calreyn88" },
      { id: 20, year: 1992, make: "Honda", model: "NR750", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/1992%20Honda%20NR750.jpg", attribution: "Mike Schinkel" },
      { id: 21, year: 1978, make: "Honda", model: "CBX1000", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/1978%20Honda%20CBX1000.jpeg", attribution: "Rene Kientopp" },
      { id: 22, year: 2006, make: "Honda", model: "CBR1000RR", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/2006%20Honda%20CBR1000RR%20Fireblade.jpg", attribution: "Sierra Odonohue" },
      { id: 23, year: 2025, make: "Honda", model: "Africa Twin", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Honda/2025%20Honda%20Africa%20Twin.jpg", attribution: "AVMOTO" },

      // Ducati
      { id: 24, year: 1973, make: "Ducati", model: "750 Sport", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/1973%20Ducati%20750%20Sport.jpg", attribution: "Craig Howell" },
      { id: 25, year: 1990, make: "Ducati", model: "851", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/1990%20Ducati%20851.jpg", attribution: "Calreyn88" },
      { id: 26, year: 1997, make: "Ducati", model: "916", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/1997%20Ducati%20916%20SPS.jpg", attribution: "ScuderiaAssindia" },
      { id: 27, year: 2003, make: "Ducati", model: "999", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/2003%20Ducati%20999.jpg", attribution: "Ligabo" },
      { id: 28, year: 2008, make: "Ducati", model: "Desmosedici RR", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/2008%20Ducati%20Desmosedici%20RR.jpg", attribution: "Pierrecol" },
      { id: 29, year: 2013, make: "Ducati", model: "Diavel", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/2013%20Ducati%20Diavel.jpg", attribution: "Shelby Asistio" },
      { id: 30, year: 2015, make: "Ducati", model: "Scrambler", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/2015%20Ducati%20Scrambler.jpg", attribution: "HansFritzvonUmlauts" },
      { id: 31, year: 2018, make: "Ducati", model: "Panigale V4", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/2018%20Ducati%20Panigale%20V4.jpeg", attribution: "Alessio Moscetti" },
      { id: 32, year: 2025, make: "Ducati", model: "Multistrada V4", image: "https://pub-4f8de16696b54a248d93364b032cdf5f.r2.dev/Ducati/2025%20Ducati%20Multistrada%20V4.jpg", attribution: "Oq10pass" }
    ];

    let dailyBike = bikes[0];
    let tries = 5;
    let solved = false;
    let finalScore = 0;
    let guessesUsed = 0;
    let guessHistory = [];
    let streak = parseInt(localStorage.getItem('motowordleStreak') || '0');
    document.getElementById('streak').textContent = streak;

    const testSelect = document.getElementById('testBikeSelect');
    bikes.forEach(bike => {
      const opt = document.createElement('option');
      opt.value = bike.id;
      opt.textContent = `${bike.year} ${bike.make} ${bike.model}`;
      testSelect.appendChild(opt);
    });

    function loadTestBike() {
      const selectedId = parseInt(testSelect.value);
      if (!selectedId) return alert("Please select a bike first");
      dailyBike = bikes.find(b => b.id === selectedId);
      resetGame();
    }

    function resetGame() {
      tries = 5;
      solved = false;
      finalScore = 0;
      guessesUsed = 0;
      guessHistory = [];
      document.getElementById('tries').textContent = tries;
      document.getElementById('scoreDisplay').textContent = "Score: 0 / 100";
      document.getElementById('message').textContent = "";
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('shareBtn').style.display = "none";
      document.getElementById('makeFeedback').textContent = "";
      document.getElementById('modelFeedback').textContent = "";
      document.getElementById('yearFeedback').textContent = "";
      updateHistoryDisplay();

      const img = document.getElementById('image');
      const origins = ["20% 30%", "80% 20%", "50% 20%", "30% 70%", "70% 80%", "25% 50%", "75% 50%", "50% 80%"];
      const randomOrigin = origins[Math.floor(Math.random() * origins.length)];
      
      img.src = dailyBike.image;
      img.style.transformOrigin = randomOrigin;
      img.style.transform = `scale(3.4)`;

      document.getElementById('attribution').textContent = dailyBike.attribution ? `Photo: ${dailyBike.attribution}` : "";

      document.getElementById('make').value = "";
      document.getElementById('model').innerHTML = '<option value="">Select Model</option>';
      document.getElementById('model').disabled = true;
      document.getElementById('year').value = "";
    }

    const zoomLevels = [3.4, 2.5, 1.9, 1.4, 1.0];
    const img = document.getElementById('image');

    function updateZoom() {
      const level = Math.min(5 - tries, zoomLevels.length - 1);
      img.style.transform = `scale(${zoomLevels[level]})`;
    }

    const makes = [...new Set(bikes.map(b => b.make))].sort();
    const makeSelect = document.getElementById('make');
    const modelSelect = document.getElementById('model');
    const makeFeedback = document.getElementById('makeFeedback');
    const modelFeedback = document.getElementById('modelFeedback');
    const yearFeedback = document.getElementById('yearFeedback');

    makes.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m;
      opt.textContent = m;
      makeSelect.appendChild(opt);
    });

    makeSelect.addEventListener('change', function() {
      const selectedMake = this.value;
      modelSelect.innerHTML = '<option value="">Select Model</option>';
      makeFeedback.textContent = '';
      modelFeedback.textContent = '';
      yearFeedback.textContent = '';

      if (!selectedMake) {
        modelSelect.disabled = true;
        return;
      }

      const models = [...new Set(bikes.filter(b => b.make === selectedMake).map(b => b.model))].sort();
      models.forEach(model => {
        const opt = document.createElement('option');
        opt.value = model;
        opt.textContent = model;
        modelSelect.appendChild(opt);
      });
      modelSelect.disabled = false;
    });

    function updateHistoryDisplay() {
      const list = document.getElementById('historyList');
      if (guessHistory.length === 0) {
        list.innerHTML = '<div class="guess-item">No guesses yet</div>';
        return;
      }

      list.innerHTML = guessHistory.map((g, i) => {
        const makeIcon = g.makeCorrect ? '<span class="correct">✓</span>' : '<span class="wrong">✗</span>';
        const modelIcon = g.modelCorrect ? '<span class="correct">✓</span>' : '<span class="wrong">✗</span>';
        const yearIcon = g.yearCorrect ? '<span class="correct">✓</span>' : '<span class="wrong">✗</span>';
        return `<div class="guess-item">
          <strong>${i + 1}.</strong> 
          ${g.make} ${makeIcon} &nbsp; 
          ${g.model} ${modelIcon} &nbsp; 
          ${g.year || '—'} ${yearIcon}
        </div>`;
      }).join('');
    }

    function calculateYearPoints(guessYear, actualYear) {
      if (isNaN(guessYear) || isNaN(actualYear)) return 0;
      const diff = Math.abs(guessYear - actualYear);
      if (diff > 20) return 0;
      return Math.max(0, 20 - diff);
    }

    function submitGuess() {
      if (tries <= 0 || solved) return;

      const guessMake = makeSelect.value;
      const guessModel = modelSelect.value;
      const guessYear = parseInt(document.getElementById('year').value);

      if (!guessMake || !guessModel) {
        document.getElementById('message').textContent = "Please select both Make and Model.";
        document.getElementById('message').className = "fail";
        return;
      }

      const makeCorrect = guessMake === dailyBike.make;
      const modelCorrect = guessModel === dailyBike.model;
      const yearCorrect = guessYear === dailyBike.year;
      const yearPoints = calculateYearPoints(guessYear, dailyBike.year);

      // Feedback icons under each field
      makeFeedback.textContent = makeCorrect ? '✓' : '✗';
      makeFeedback.className = 'feedback-icon ' + (makeCorrect ? 'correct' : 'wrong');

      modelFeedback.textContent = modelCorrect ? '✓' : '✗';
      modelFeedback.className = 'feedback-icon ' + (modelCorrect ? 'correct' : 'wrong');

      yearFeedback.textContent = yearCorrect ? '✓' : '✗';
      yearFeedback.className = 'feedback-icon ' + (yearCorrect ? 'correct' : 'wrong');

      // Save to history
      guessHistory.push({
        make: guessMake,
        model: guessModel,
        year: guessYear || null,
        makeCorrect,
        modelCorrect,
        yearCorrect
      });
      updateHistoryDisplay();

      const messageEl = document.getElementById('message');
      const scoreEl = document.getElementById('scoreDisplay');
      guessesUsed = 6 - tries;

      if (makeCorrect && modelCorrect) {
        finalScore = 80 + yearPoints;
        solved = true;
        document.getElementById('submitBtn').disabled = true;
        
        img.style.transformOrigin = "center center";
        img.style.transform = "scale(1)";
        
        document.getElementById('shareBtn').style.display = "inline-block";

        let yearMsg = yearPoints === 20 ? " Perfect year!" :
                      yearPoints > 0   ? ` Year was ${20 - yearPoints} year(s) off.` :
                                         " Year >20 years off (0 pts).";

        messageEl.textContent = `Correct! ${dailyBike.year} ${dailyBike.make} ${dailyBike.model}.${yearMsg}`;
        messageEl.className = "success";
        scoreEl.textContent = `Score: ${finalScore} / 100`;

        streak++;
        localStorage.setItem('motowordleStreak', streak);
        document.getElementById('streak').textContent = streak;
      } else {
        tries--;
        document.getElementById('tries').textContent = tries;
        updateZoom();
        
        messageEl.textContent = "Incorrect. Zooming out…";
        messageEl.className = "fail";
        scoreEl.textContent = "Score: 0 / 100";

        if (tries === 0) {
          img.style.transformOrigin = "center center";
          img.style.transform = "scale(1)";
          messageEl.textContent = `Out of tries. It was a ${dailyBike.year} ${dailyBike.make} ${dailyBike.model}.`;
          document.getElementById('submitBtn').disabled = true;
          document.getElementById('shareBtn').style.display = "inline-block";
          streak = 0;
          localStorage.setItem('motowordleStreak', 0);
          document.getElementById('streak').textContent = 0;
          finalScore = 0;
          guessesUsed = 5;
        }
      }
    }

    function revealAnswer() {
      if (solved) return;
      img.style.transformOrigin = "center center";
      img.style.transform = "scale(1)";
      document.getElementById('message').textContent = `Answer: ${dailyBike.year} ${dailyBike.make} ${dailyBike.model}`;
      document.getElementById('message').className = "fail";
      document.getElementById('submitBtn').disabled = true;
      document.getElementById('tries').textContent = 0;
      document.getElementById('shareBtn').style.display = "inline-block";
      streak = 0;
      localStorage.setItem('motowordleStreak', 0);
      document.getElementById('streak').textContent = 0;
      finalScore = 0;
      guessesUsed = 5;
    }

    function shareResults() {
      const today = new Date().toISOString().slice(0, 10);
      const emojiLine = solved 
        ? "🟩".repeat(guessesUsed) + "⬜".repeat(5 - guessesUsed)
        : "🟥".repeat(5);

      const text = `🏍️ MotoWordle ${today}
Score: ${finalScore}/100
${emojiLine}
Tries: ${guessesUsed}/5
🔥 Streak: ${streak}`;

      navigator.clipboard.writeText(text).then(() => {
        document.getElementById('message').textContent = "Results copied to clipboard!";
        document.getElementById('message').className = "success";
      }).catch(() => alert(text));
    }

    window.onload = () => {
      testSelect.value = "1";
      loadTestBike();
    };

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') submitGuess();
    });
  </script>
</body>
</html>
